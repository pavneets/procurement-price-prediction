),
pos as (
    select * from "warehouse"."silver"."purchase_orders"
),
reconciled as (
    select
        lines.po_number,
        lines.customer_id as customer_id_line,
        pos.customer_id as customer_id_header,
        lines.vendor_id,
        lines.item_id,
        pos.order_date,
        pos.status,
        lines.quantity_ordered,
        lines.unit_price_paid
    from lines
    inner join pos
        on lines.po_number = pos.po_number
)
select *
from reconciled
where customer_id_line != customer_id_header
    );
    
  
[0m18:27:34.047043 [debug] [Thread-1 (]: On model.procurement_lakehouse.item_purchase_history: /* {"app": "dbt", "dbt_version": "1.12.7", "profile_name": "procurement_lakehouse", "target_name": "dev", "node_id": "model.procurement_lakehouse.item_purchase_history"} */

    

    create  table
      "warehouse"."gold"."item_purchase_history__dbt_tmp"
  
    
    as (
      with lines as (

    select * from "warehouse"."silver"."itemized_purchase_orders"

),

pos as (

    select * from "warehouse"."silver"."purchase_orders"

),

items as (

    select * from "warehouse"."silver"."items"

),

joined as (

    select
        lines.item_id,
        lines.unit_price_paid,
        pos.order_date
    from lines
    inner join pos   on lines.po_number = pos.po_number
    inner join items on lines.item_id   = items.item_id

),

aggregated as (

    select
        item_id,
        count(*)                                                       as purchase_frequency,
        min(order_date)                                                as earliest_purchase_date,
        max(order_date)                                                as latest_purchase_date,
        percentile_cont(0.25) within group (order by unit_price_paid)  as price_p25,
        percentile_cont(0.50) within group (order by unit_price_paid)  as price_p50,
        percentile_cont(0.75) within group (order by unit_price_paid)  as price_p75,
        percentile_cont(0.90) within group (order by unit_price_paid)  as price_p90
    from joined
    group by item_id

)

select * from aggregated
order by item_id
    );
    
  
